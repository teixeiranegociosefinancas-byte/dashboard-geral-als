# Copiar para .env em desenvolvimento local, ou configurar como variável de
# ambiente no projeto do backend no Vercel em produção (Project Settings →
# Environment Variables). NUNCA commitar o .env de verdade.

MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_DB_NAME=dashboard_geral_als

# Chave secreta que só o Claude (e o painel, no upload manual) conhece.
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
INGEST_API_KEY=troque-por-uma-chave-gerada
